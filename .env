# Core
NODE_ENV=development
APP_URL=http://localhost:3000
# 32+ char secret for session signing
AUTH_SECRET=change-me-32-chars-minimum-secret

# SQLite (default, zero setup) - Postgres is supported too:
# DATABASE_URL=postgresql://studio:studio@localhost:5432/studio?schema=public
DATABASE_URL=file:./dev.db

# Redis (optional - enables BullMQ + pub/sub realtime; without it the app
# falls back to DB polling + in-memory queue)
REDIS_URL=

# Storage
STORAGE_DRIVER=local            # local | s3
STORAGE_LOCAL_DIR=./storage
# S3_ENDPOINT=https://ams3.digitaloceanspaces.com
# S3_REGION=us-east-1
# S3_BUCKET=studio-assets
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_BASE_URL=https://studio-assets.ams3.digitaloceanspaces.com

# AI (mock works out of the box - no keys needed)
AI_PROVIDER=mock               # mock | openai | anthropic | gemini
# AI_MOCK_LATENCY_MS=0
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# TTS
TTS_PROVIDER=mock              # mock | openai | elevenlabs
# TTS_MOCK_LATENCY_MS=0
# TTS_VOICE=alloy
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# Rendering
RENDER_ENGINE=dev              # dev (mock previews) | remotion (real renders)
RENDER_FPS=30
RENDER_WIDTH=1920
RENDER_HEIGHT=1080
RENDER_CONCURRENCY=2

# YouTube publishing (mock works out of the box)
# youtubeMode = mock | oauth. OAuth needs a Google Cloud OAuth client:
# https://console.cloud.google.com/apis/credentials
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/youtube/callback
# 32-byte hex key for encrypting stored tokens
YOUTUBE_ENCRYPTION_KEY=00000000000000000000000000000000

# Email (registration verification + password reset)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="AI Video Studio <noreply@example.com>"

# Rate limits & quotas (requests per minute)
RATE_LIMIT_AI=30
RATE_LIMIT_RENDER=5
RATE_LIMIT_UPLOAD=20
RATE_LIMIT_PUBLISH=5
RATE_LIMIT_DEFAULT=120
MAX_UPLOAD_BYTES=524288000
STORAGE_QUOTA_BYTES=10737418240

# Worker
WORKER_PORT=8787
WORKER_CONCURRENCY=2